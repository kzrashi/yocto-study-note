        <mxCell id="p13_dgpu_cpu" value="CPU + システム RAM&#xa;（DDR5）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
