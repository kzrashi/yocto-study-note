        <!-- ===== Qt5/Qt6 コード例 ===== -->
        <mxCell id="p22_code_t" value="QQuickFramebufferObject の使い方（Qt5 / Qt6 共通）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p22_code" value="// C++ 側（Qt5 / Qt6 共通）&#xa;class MyFboItem : public QQuickFramebufferObject {&#xa;    Renderer *createRenderer() const override {&#xa;        return new MyRenderer(); // OpenGL 描画はここ&#xa;    }&#xa;};&#xa;&#xa;// QML 側&#xa;MyFboItem {&#xa;    width: 800; height: 600&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="500" height="160" as="geometry" />
        </mxCell>

        <!-- Qt6 RhiItem -->
        <mxCell id="p22_rhi_t" value="Qt 6.7 以降：QQuickRhiItem（より新しい方法）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p22_rhi" value="// Qt 6.7 以降&#xa;class MyRhiItem : public QQuickRhiItem {&#xa;    QQuickRhiItemRenderer *createRenderer() override {&#xa;        return new MyRhiRenderer();&#xa;    }&#xa;};&#xa;&#xa;// Qt RHI（OpenGL/Vulkan 抽象化）を使って描画&#xa;// QQuickFramebufferObject より柔軟・高性能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="630" width="580" height="160" as="geometry" />
