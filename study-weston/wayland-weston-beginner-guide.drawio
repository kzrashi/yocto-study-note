        </mxCell>
        <mxCell id="p15_l3" value="③ CPU でピクセルを書き込む&#xa;（ソフトウェアレンダリング）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
