        <mxCell id="p16_th0" value="ケース" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="596" width="240" height="36" as="geometry" />
