  <!-- ========== PAGE 16: mmap を使うケース ========== -->
  <diagram name="16. mmapを使うケース" id="p16">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="p16_t" value="mmap（wl_shm）を使うケース" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="12" width="840" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p16_sub" value="wl_shm は Wayland の必須プロトコル（全コンポジターが対応義務あり）　linux-dmabuf は拡張仕様（オプション）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="58" width="1000" height="22" as="geometry" />
        </mxCell>

        <!-- ===== 6つのケース（3列×2行） ===== -->

        <!-- ケース① CPU ソフトウェアレンダリング -->
        <mxCell id="p16_c1" value="① CPU ソフトウェアレンダリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c1b" value="GPU を使わず CPU でピクセルを書くアプリ&#xa;&#xa;例：ターミナルエミュレータ&#xa;　　テキストエディタ（gedit 等）&#xa;　　通知ポップアップ・ステータスバー&#xa;　　Cairo ライブラリで描画するアプリ&#xa;&#xa;→ OpenGL を使わないので dmabuf 不要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="134" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- ケース② GPU ドライバ未対応 -->
        <mxCell id="p16_c2" value="② GPU ドライバが dmabuf 非対応の環境" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="90" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c2b" value="組み込み機器では GPU ドライバが未成熟なことも&#xa;&#xa;例：DRM 未対応の安価な SoC&#xa;　　古い BSP（Board Support Package）&#xa;　　QEMU 仮想マシンの一部構成&#xa;&#xa;→ dmabuf が使えないので&#xa;　 wl_shm にフォールバック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="134" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- ケース③ カーソル -->
        <mxCell id="p16_c3" value="③ カーソル・アイコン等の小さい画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c3b" value="Weston はマウスカーソル画像に wl_shm を使う&#xa;&#xa;理由：&#xa;　・カーソルは 32×32px 程度と小さい&#xa;　・GPU を使うほどでもない&#xa;　・wl_shm で十分に速い&#xa;&#xa;→ アプリ画面は dmabuf&#xa;　 カーソルは wl_shm と使い分ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="790" y="134" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- ケース④ スクリーンショット -->
        <mxCell id="p16_c4" value="④ スクリーンショット・画面キャプチャ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="318" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c4b" value="GPU バッファを CPU で読み出す必要がある場面&#xa;&#xa;フロー：&#xa;GPU メモリ（dmabuf）&#xa;　↓ CPU が読み出し（readback）&#xa;共有メモリ（mmap）&#xa;　↓&#xa;PNG 保存 / 動画エンコード / ストリーミング&#xa;&#xa;→ GPU→CPU の橋渡しに mmap が必要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="362" width="340" height="178" as="geometry" />
        </mxCell>

        <!-- ケース⑤ XWayland -->
        <mxCell id="p16_c5" value="⑤ XWayland（X11 アプリの互換レイヤー）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="318" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c5b" value="X11 アプリを Wayland 上で動かす互換レイヤー&#xa;&#xa;X11 アプリ → XWayland → wl_shm → Weston&#xa;&#xa;X11 は元々 GPU メモリの直接共有の&#xa;仕組みを持たないため&#xa;wl_shm 経由が一般的&#xa;&#xa;→ 古い X11 アプリを Wayland 環境で&#xa;　 使い続けるための互換手段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="362" width="340" height="178" as="geometry" />
        </mxCell>

        <!-- ケース⑥ デバッグ・学習 -->
        <mxCell id="p16_c6" value="⑥ デバッグ・学習・プロトタイプ開発" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="318" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_c6b" value="wl_shm は実装がシンプルで理解しやすい&#xa;&#xa;理由：&#xa;　・GPU ドライバ不要&#xa;　・DRM/GEM の知識不要&#xa;　・memcpy で書けば動く&#xa;　・動作確認・Wayland 学習に最適&#xa;&#xa;→ まず wl_shm で動かしてから&#xa;　 dmabuf に移行するのが定石" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="790" y="362" width="340" height="178" as="geometry" />
        </mxCell>

        <!-- ===== 判断フロー ===== -->
        <mxCell id="p16_flow_t" value="使い分けの判断フロー" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="566" width="400" height="26" as="geometry" />
        </mxCell>

        <mxCell id="p16_q1" value="GPU（OpenGL/Vulkan）で描画する？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="598" width="240" height="70" as="geometry" />
