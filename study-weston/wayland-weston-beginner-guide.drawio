        <mxCell id="p15_l_who" value="使う場面：CPU で描画するアプリ（Cairo / Qt ソフトレンダリング等）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#996600;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="510" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p15_l1" value="① アプリが shm_open() で&#xa;共有メモリ領域を作成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="132" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p15_l2" value="② アプリが mmap() で&#xa;自分のアドレス空間に貼り付ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
