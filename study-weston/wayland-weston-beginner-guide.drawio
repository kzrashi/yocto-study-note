                <mxCell id="p3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#006600;" parent="1" source="p3_a3" target="p3_comp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_l2lbl" value="【層2】コンポジター（Waylandサーバー）─ X11の層2+層3を1つに統合！" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="235" width="700" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p3_comp" value="コンポジター（Waylandサーバー）&#xa;─────────────────────&#xa;✅ 描画命令の受け取り　　✅ ウィンドウ管理&#xa;✅ 画面の合成　　　　　　✅ 入力デバイス管理&#xa;&#xa;→ X11の「Xサーバー」＋「コンポジター」を1つにまとめた！" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="265" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e4" value="最終画像を送る" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#006600;fontStyle=1;" parent="1" source="p3_comp" target="p3_mon" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_mon" value="🖥️ モニター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="490" width="220" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3_ben_t" value="✅ Wayland の利点" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="130" width="280" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p3_ben" value="① シンプルな2層構造&#xa;    処理が速い・低遅延・ティアリングなし&#xa;&#xa;② コンポジターが一体化&#xa;    二重処理がなく効率的&#xa;&#xa;③ セキュリティが高い&#xa;    アプリ間は完全に隔離される&#xa;    → 他アプリの入力を見れない&#xa;&#xa;④ 現代的な設計（2008年〜）&#xa;    タッチスクリーン・HDPIに対応&#xa;    ジェスチャー・高解像度に最適&#xa;&#xa;⑤ 組み込み機器に最適&#xa;    軽量・省メモリ・省CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="560" y="168" width="530" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sec_t" value="🔒 セキュリティ改善のイメージ" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="498" width="360" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3_evil" value="😈 悪意のある&#xa;アプリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="538" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3_good2" value="🔑 パスワード入力中&#xa;のアプリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="870" y="538" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3_block" value="❌ アクセス不可！完全に隔離" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00AA00;fontColor=#00AA00;fontStyle=1;fontSize=12;dashed=1;" parent="1" source="p3_evil" target="p3_good2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_iso_note" value="Waylandではコンポジターが各アプリを完全に隔離管理するため&#xa;他のアプリのウィンドウ内容や入力イベントを読み取ることが不可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="560" y="628" width="530" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="4. X11 vs Wayland 比較" id="p4">
        <mxGraphModel dx="1326" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
