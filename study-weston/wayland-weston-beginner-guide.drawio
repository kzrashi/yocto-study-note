        <mxCell id="p16_fno1" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#CC0000;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" source="p16_q1" target="p16_q2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p16_fno2" value="NO →フォールバック" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#CC0000;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="p16_q2" target="p16_mmap1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 比較表 ===== -->
        <mxCell id="p16_tbl_t" value="まとめ：どちらを使うか" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="566" width="580" height="26" as="geometry" />
