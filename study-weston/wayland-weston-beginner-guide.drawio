        <!-- key point -->
        <mxCell id="p24_key" value="🎯 GStreamer は「アプリに組み込む部品（ライブラリ）」として設計されているため同じプロセスで動く。別プロセスにする理由がなく、同じプロセスの方が速くて効率的。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="896" width="1120" height="36" as="geometry" />
