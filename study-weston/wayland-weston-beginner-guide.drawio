        </mxCell>
        <mxCell id="p24_th2" value="Qt Render スレッド&#xa;GPU 描画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="274" y="552" width="220" height="52" as="geometry" />
        </mxCell>
