        <mxCell id="p16_th1" value="wl_shm（mmap）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="596" width="160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p16_th2" value="linux-dmabuf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="596" width="160" height="36" as="geometry" />
