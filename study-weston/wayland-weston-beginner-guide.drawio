          <mxGeometry x="34" y="622" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p24_th4" value="GStreamer Sink スレッド&#xa;フレーム出力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="274" y="622" width="220" height="52" as="geometry" />
        </mxCell>

        <!-- ===== 右側：なぜ同じプロセスか 4理由 ===== -->
        <mxCell id="p24_why_t" value="なぜ同じプロセスで動くのか？ ─ 4つの理由" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="86" width="560" height="24" as="geometry" />
        </mxCell>

        <!-- 理由① ライブラリ設計 -->
        <mxCell id="p24_r1" value="① GStreamer は .so ライブラリとして設計されている" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="114" width="560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p24_r1b" value="アプリ起動時に dlopen() でメモリに読み込まれる&#xa;→ アプリのメモリ空間に展開・同じプロセスの一部になる&#xa;→ 別プロセスを立ち上げる必要がない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="154" width="560" height="68" as="geometry" />
        </mxCell>

        <!-- 理由② 性能 -->
        <mxCell id="p24_r2" value="② 別プロセスにすると映像転送コストが巨大になるから" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="234" width="560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p24_r2b" value="別プロセス（もしそうなら）：&#xa;  IPC でフレームを転送 → 8MB × 60fps = 480MB/秒 コピー 😱&#xa;&#xa;同じプロセス：&#xa;  ポインタ・fd を渡すだけ → データコピーゼロ ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="274" width="560" height="80" as="geometry" />
        </mxCell>

        <!-- 理由③ Qt プラグイン設計 -->
        <mxCell id="p24_r3" value="③ Qt Multimedia はバックエンドをプラグインで切り替える設計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="366" width="560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p24_r3b" value="Qt Multimedia → プラグイン（.so）を動的ロード&#xa;  ・GStreamer バックエンド&#xa;  ・FFmpeg バックエンド&#xa;  どちらも同じプロセスに読み込まれる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="406" width="560" height="72" as="geometry" />
        </mxCell>

        <!-- 理由④ dmabuf fd 共有 -->
        <mxCell id="p24_r4" value="④ dmabuf fd の共有が同じプロセス内で完結するから" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p24_r4b" value="GStreamer が dmabuf fd=5 を生成&#xa;  → 同じプロセス内の Qt Multimedia に渡す（整数を渡すだけ）&#xa;  → EGLCreateImageKHR(fd=5) で GPU テクスチャ作成&#xa;  → データコピーゼロ・瞬時に完了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="560" height="72" as="geometry" />
        </mxCell>

        <!-- ===== 別プロセスになるケース ===== -->
        <mxCell id="p24_sep_t" value="別プロセスになるケース" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="320" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p24_tbl_h0" value="使い方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="728" width="360" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p24_tbl_h1" value="プロセス構成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="728" width="760" height="32" as="geometry" />
        </mxCell>

