                    <mxGeometry x="80" y="15" width="940" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_good" value="✅ シンプル！コンポジターが一体化！2層だけ！" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="72" width="680" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p3_l1lbl" value="【層1】Waylandクライアント（アプリ）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="130" width="400" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p3_a1" value="アプリA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="162" width="115" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p3_a2" value="アプリB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="170" y="162" width="115" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p3_a3" value="アプリC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="300" y="162" width="115" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e1" value="Waylandプロトコルで通信" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#006600;fontColor=#006600;" parent="1" source="p3_a1" target="p3_comp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
