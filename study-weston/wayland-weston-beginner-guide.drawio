        <mxCell id="p26_vo2" value="QSGVideoNode&#xa;（Scene Graph ノード）&#xa;カメラフレームのテクスチャを設定&#xa;YUV→RGB シェーダー内蔵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="756" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p26_vo3" value="Render Thread が描画&#xa;GPU → フレームバッファ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="766" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p26_vo4" value="dmabuf → Weston → 🖥️" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="766" width="200" height="44" as="geometry" />
