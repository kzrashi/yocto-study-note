                <mxCell id="p11_uk_apps" value="GUIアプリ　　　　　　libwayland-client　　　　libwayland-server　　　　Weston" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
