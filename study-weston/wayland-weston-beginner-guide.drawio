        <mxCell id="p20_ke2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;" edge="1" source="p20_weston_k" target="p20_kms_box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p20_ke3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;" edge="1" source="p20_kms_box" target="p20_mon" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LPDDR5 → dmabuf 矢印（カーネル境界越え） -->
        <mxCell id="p20_cross3" value="ioctl()" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CC0000;fontColor=#CC0000;fontStyle=1;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="p20_lpddr" target="p20_dmabuf_box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== LPDDR5 物理メモリ図 ===== -->
        <mxCell id="p20_ram_t" value="物理 LPDDR5（i.MX95 統合メモリ）" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#996600;" vertex="1" parent="1">
          <mxGeometry x="30" y="718" width="740" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p20_ram_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="742" width="740" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p20_ram_cpu" value="CPU アドレス空間（QImage）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="44" y="754" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p20_ram_copy" value="← コピー（glTexImage2D）→" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="288" y="762" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p20_ram_gpu" value="GPU アドレス空間（テクスチャ/フレームバッファ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="492" y="754" width="264" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p20_ram_note" value="物理チップは同一（UMA）だがアドレス空間が違うためコピーが必要" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#996600;" vertex="1" parent="1">
          <mxGeometry x="30" y="804" width="740" height="20" as="geometry" />
        </mxCell>

        <!-- ===== CPU vs GPU 役割メモ ===== -->
        <mxCell id="p20_role_t" value="各ステップの役割" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="718" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p20_role" value="① QImage 生成　　→ CPU（デコード・加工）&#xa;② glTexImage2D　 → CPU→GPU コピー（1回のみ）&#xa;③ Scene Graph    → GPU（テクスチャ描画）&#xa;④ dmabuf / KMS   → GPU→ディスプレイ（ゼロコピー）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="744" width="330" height="80" as="geometry" />
        </mxCell>

        <!-- key point -->
        <mxCell id="p20_key" value="🎯 QImage のコピーは glTexImage2D の1回だけ。静止画なら問題なし。毎フレーム更新する映像には重いので dmabuf 直接使用を検討する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="830" width="1100" height="36" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

