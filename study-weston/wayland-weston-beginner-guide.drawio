                <mxCell id="1" parent="0"/>
                <mxCell id="p9_t" value="libwayland とは？" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="15" width="740" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p9_sub" value="「WaylandプロトコルをC言語で使いやすくしたライブラリ」― アプリとWestonが「話す」ための道具" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="100" y="62" width="940" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p9_why_t" value="なぜ必要か？ ─ アプリと Weston は別プロセスで直接話せない" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="720" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p9_ap" value="GUIアプリのプロセス&#xa;（独立したメモリ空間）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="138" width="220" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p9_sock" value="Unix ドメインソケット&#xa;/run/user/1000/wayland-0&#xa;&#xa;プロセス間通信（IPC）の経路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="138" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p9_wp" value="Westonのプロセス&#xa;（独立したメモリ空間）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="138" width="220" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p9_e1" value="libwayland-client" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#0033CC;fontStyle=1;" parent="1" source="p9_ap" target="p9_sock" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9_e2" value="libwayland-server" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#006600;fontStyle=1;" parent="1" source="p9_sock" target="p9_wp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9_split_t" value="libwayland の2分割構造" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="248" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p9_lc" value="libwayland-client&#xa;─────────────────&#xa;GUIアプリが使う&#xa;&#xa;・Westonへ要求を送る&#xa;・入力イベントを受け取る&#xa;&#xa;例：wl_surface_commit()&#xa;　　wl_display_connect()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="285" width="280" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p9_ls" value="libwayland-server&#xa;─────────────────&#xa;Westonが使う&#xa;&#xa;・アプリの要求を受け取る&#xa;・イベントをアプリへ送る&#xa;&#xa;例：wl_display_create()&#xa;　　wl_client_get_object()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="400" y="285" width="280" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p9_ph" value="📞 電話のたとえ&#xa;─────────────────&#xa;libwayland-client&#xa;＝ 電話をかける側&#xa;&#xa;libwayland-server&#xa;＝ 電話を受ける側&#xa;&#xa;どちらも同じ&#xa;電話網（ソケット）を使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="740" y="285" width="240" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p9_cmp_t" value="libwayland があるとないとでは？" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="530" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p9_with" value="✅ libwayland あり&#xa;─────────────────────────────&#xa;wl_surface_commit(surface);&#xa;　↑ 関数を呼ぶだけ！&#xa;　　内部の通信は自動処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="568" width="440" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p9_wout" value="❌ libwayland なし&#xa;─────────────────────────────&#xa;ソケットを自分で open()&#xa;→ バイナリプロトコルを手書き&#xa;→ メッセージを手動シリアライズ&#xa;→ ヘッダ・オブジェクトIDを管理&#xa;→ 送受信・エラー処理を自前実装&#xa;　　　　　　→ 地獄😱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="560" y="568" width="440" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p9_xml" value="💡 libwayland のコードの多くは Wayland プロトコルの XML 定義ファイルから自動生成される。&#xa;　  つまり「プロトコル仕様（XML）→ wayland-scanner → C言語コード（libwayland）」という流れ。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="740" width="1080" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
