          <mxGeometry x="20" y="776" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef_eglfs" value="eglfs モード&#xa;（QT_QPA_PLATFORM=eglfs）&#xa;─────────────────────────&#xa;Qt5 アプリ → DRM/KMS → モニター&#xa;Weston 不要・1アプリ専用機器向け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="776" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p18_ef_sw" value="ソフトウェアモード&#xa;（QMLSCENE_DEVICE=softwarecontext）&#xa;─────────────────────────&#xa;Qt5 アプリ → CPU → wl_shm&#xa;GPU 不要・デバッグ用途" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="740" y="776" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- key point -->
        <mxCell id="p18_key" value="🎯 Qt5 も Qt6 も QML は GPU レンダリング。違いは Qt6 が Qt RHI で OpenGL/Vulkan/Metal を抽象化した点のみ。Weston との dmabuf 連携・i.MX95 でのゼロコピーは Qt5 でも Qt6 でも動く。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="878" width="1130" height="36" as="geometry" />
        </mxCell>

