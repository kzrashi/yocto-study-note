        <mxCell id="p15_l4" value="④ Wayland（wl_shm）経由で&#xa;共有メモリの fd を Weston に通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
