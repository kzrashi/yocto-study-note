        <mxCell id="p26_voe1" value="updatePaintNode()" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontColor=#003399;fontSize=10;" edge="1" source="p26_vo1" target="p26_vo2" parent="1">
