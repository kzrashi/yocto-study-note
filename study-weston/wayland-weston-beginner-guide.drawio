        <mxCell id="p13_tbl" value="項目　　　　　　　　　　　　内容&#xa;────────────────────────────────────────&#xa;GPU の種類　　　　　　　　　統合 GPU（Mali-G310 MP4）&#xa;メモリ構造　　　　　　　　　UMA（CPU・GPU が LPDDR5 を共有）&#xa;VRAM　　　　　　　　　　　　なし（システム RAM を一部割り当て）&#xa;dmabuf の効果　　　　　　　完全ゼロコピー（物理転送なし）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="480" height="78" as="geometry" />
        </mxCell>

        <!-- key point -->
        <mxCell id="p13_key" value="🎯 i.MX95 は統合 GPU + UMA 構成のため、dmabuf を使うと物理コピーが一切発生しない。&#xa;　  Weston + dmabuf の組み合わせが最も効果を発揮する典型的な組み込み構成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="580" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
