        </mxCell>
        <mxCell id="p24_th1" value="メインスレッド&#xa;QML / UI 処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
