        <mxCell id="p15_l5" value="⑤ Weston も mmap() で&#xa;同じ共有メモリを参照して合成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
