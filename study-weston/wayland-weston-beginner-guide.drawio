          <mxGeometry x="340" y="613" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p16_q2" value="GPU ドライバが dmabuf 対応？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p16_mmap1" value="wl_shm（mmap）✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p16_fye1" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontColor=#006600;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="p16_q1" target="p16_yes1" parent="1">
