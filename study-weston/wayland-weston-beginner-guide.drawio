                    <mxGeometry x="40" y="235" width="300" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p2_xs" value="Xサーバー（Xorg）&#xa;─────────────&#xa;・アプリの描画命令を受け取る&#xa;・入力デバイスを管理&#xa;・ウィンドウ位置を管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff9999;strokeColor=#cc0000;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="265" width="390" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e4" value="描画データを渡す" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2_xs" target="p2_comp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l3lbl" value="【層3】コンポジター" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="390" width="300" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p2_comp" value="コンポジター（例: Mutter / KWin）&#xa;─────────────&#xa;各ウィンドウの画像を受け取り&#xa;1枚の画面に合成する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#ff8800;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="422" width="390" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e5" value="最終画像を送る" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2_comp" target="p2_mon" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_mon" value="🖥️ モニター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="120" y="595" width="220" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_prob_t" value="❌ X11 の問題点" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="530" y="130" width="280" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p2_prob" value="① 3層構造で処理が遅い&#xa;    Xサーバー → コンポジターへの&#xa;    二重処理が発生する&#xa;&#xa;② Xサーバーとコンポジターが別々&#xa;    → 同期が複雑でティアリングが起きやすい&#xa;&#xa;③ セキュリティが甘い&#xa;    → アプリAがアプリBのキー入力を&#xa;       盗み見できてしまう！&#xa;&#xa;④ 1984年の設計で古すぎる&#xa;    → タッチスクリーン・HDPIに非対応&#xa;    → ネットワーク越し前提で無駄が多い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="530" y="168" width="560" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sec_t" value="🔓 セキュリティ問題のイメージ" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="530" y="428" width="340" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p2_evil" value="😈 悪意のある&#xa;アプリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="468" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_good" value="🔑 パスワード入力中&#xa;のアプリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="840" y="468" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_hack" value="キー入力を盗み見できる！😱" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FF0000;fontColor=#FF0000;fontStyle=1;fontSize=12;" parent="1" source="p2_evil" target="p2_good" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_xs_note" value="X11ではすべてのアプリが&#xa;同じXサーバーバスを共有するため&#xa;他アプリの入力を傍受できてしまう" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="530" y="560" width="480" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="3. Waylandの仕組み（新しい）" id="p3">
        <mxGraphModel dx="1326" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
