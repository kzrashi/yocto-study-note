        </mxCell>
        <mxCell id="p26_d_note" value="→ 変わったノードだけ GPU に再送信。変わっていない部分はキャッシュを使いまわす。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="592" y="654" width="536" height="48" as="geometry" />
        </mxCell>

        <!-- ===== VideoOutput での Scene Graph ===== -->
        <mxCell id="p26_vo_t" value="VideoOutput での Scene Graph の使われ方" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
